  {
    "Name": "Synergy",
    "Description": "Upon reaching 100% Counter Progress by scoring Weapon Kills:\nRank-And-File = 8.34% ↑12.5% | Elite = 16.7% ↑20% | Miniboss = 34% | Boss = 50% | Guardians = 16.7% ↑25?%\nSpawns a Weapon-Matching Elemental Pickup. Kinetic Weapons spawn an Orb of Power that grants 7.15% Super Energy.\nKill counter persists through stow. Simultaneous Kills that exceed the counter dont progress into the next counter.\n ↑Enhanced Synergy does not trigger nor is it affected by the global cooldown of pickups.\n\nAll of the following applies only to BASE Synergy.\nSynergy ignores the global cooldown for Pickups, but will trigger the global cooldown upon spawning one. Synergy has its own cooldown depending on the spawned Pickup:\nIonic Traces = 0 seconds | Firesprites, Void Breaches, and Stasis Shards = 5 seconds | Tangles = 12 seconds\nKills during Synergy's cooldown do not contribute to the activation.",
    "hash": 3820243349,
    "parentHash": "3820243349",
    "hash_warning": "Multiple matches found (2 total)",
    "descriptions": {
      "en": [
        {
          "linesContent": [
            {
              "text": "Upon reaching 100% Counter Progress by scoring Weapon Kills:"
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Rank-And-File = 8.34% "
            },
            {
              "text": "↑12.5%",
              "classNames": [
                "enhancedArrow"
              ]
            },
            {
              "text": " | Elite = 16.7% "
            },
            {
              "text": "↑20%",
              "classNames": [
                "enhancedArrow"
              ]
            },
            {
              "text": " | Miniboss = 34% | Boss = 50% | Guardians = 16.7% "
            },
            {
              "text": "↑25?%",
              "classNames": [
                "enhancedArrow"
              ]
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Spawns a Weapon-Matching Elemental Pickup. "
            },
            {
              "text": "Kinetic Weapons",
              "classNames": [
                "kinetic"
              ]
            },
            {
              "text": " spawn an Orb of Power that grants 7.15% Super Energy."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Kill counter persists through stow. Simultaneous Kills that exceed the counter dont progress into the next counter."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "↑Enhanced Synergy does not trigger nor is it affected by the global cooldown of pickups.",
              "classNames": [
                "enhancedArrow"
              ]
            }
          ]
        },
        {
          "classNames": [
            "spacer"
          ]
        },
        {
          "linesContent": [
            {
              "text": "All of the following applies only to BASE "
            },
            {
              "text": "Synergy",
              "classNames": [
                "perkname"
              ]
            },
            {
              "text": "."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Synergy",
              "classNames": [
                "perkname"
              ]
            },
            {
              "text": " ignores the global cooldown for Pickups, but will trigger the global cooldown upon spawning one. "
            },
            {
              "text": "Synergy",
              "classNames": [
                "perkname"
              ]
            },
            {
              "text": " has its own cooldown depending on the spawned Pickup:"
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Ionic Traces",
              "classNames": [
                "arc"
              ]
            },
            {
              "text": " = 0 seconds | "
            },
            {
              "text": "Firesprites",
              "classNames": [
                "solar"
              ]
            },
            {
              "text": ", "
            },
            {
              "text": "Void Breaches",
              "classNames": [
                "void"
              ]
            },
            {
              "text": ", and "
            },
            {
              "text": "Stasis Shards",
              "classNames": [
                "stasis"
              ]
            },
            {
              "text": " = 5 seconds | "
            },
            {
              "text": "Tangles",
              "classNames": [
                "strand"
              ]
            },
            {
              "text": " = 12 seconds"
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Kills during "
            },
            {
              "text": "Synergy",
              "classNames": [
                "perkname"
              ]
            },
            {
              "text": "'s cooldown do not contribute to the activation."
            }
          ]
        }
      ]
    }
  },
