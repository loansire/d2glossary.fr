  {
    "Name": "Synergy",
    "Description": "Scoring 12 ↑8 [6 ↑4?] Weapon Kills spawns a Weapon Element-Matching Subclass Pickup.\n Kinetic Weapons instead spawn an Orb of Power that grants 7.15% Super Energy.\nKill counter persists through stow.\n\nSynergy ignores the global cooldown for Pickups, but will trigger the global cooldown upon spawning one.\nSynergy has its own cooldown depending on the spawned Pickup:\nIonic Traces = 0 seconds\nFiresprites, Void Breaches, and Stasis Shards = 5 seconds.\nTangles = 12 seconds\nCan spawn 2 Pickups simultaneously if the 12th kill would also trigger a different Pickup spawner.\n\nKills during Synergy's cooldown do not contribute to the activation.",
    "descriptions": {
      "en": [
        {
          "linesContent": [
            {
              "text": "Scoring 12 "
            },
            {
              "text": "↑8",
              "classNames": [
                "enhancedArrow"
              ]
            },
            {
              "text": " ["
            },
            {
              "text": "6 ↑4?",
              "classNames": [
                "pvp"
              ]
            },
            {
              "text": "] Weapon Kills spawns a Weapon Element-Matching Subclass Pickup."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Kinetic Weapons instead spawn an Orb of Power that grants 7.15% Super Energy."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Kill counter persists through stow."
            }
          ]
        },
        {
          "classNames": [
            "spacer"
          ]
        },
        {
          "linesContent": [
            {
              "text": "Synergy ignores the global cooldown for Pickups, but will trigger the global cooldown upon spawning one."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Synergy has its own cooldown depending on the spawned Pickup:"
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Ionic Traces",
              "classNames": [
                "arc"
              ]
            },
            {
              "text": " = 0 seconds"
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Firesprites",
              "classNames": [
                "solar"
              ]
            },
            {
              "text": ", "
            },
            {
              "text": "Void Breaches",
              "classNames": [
                "void"
              ]
            },
            {
              "text": ", and "
            },
            {
              "text": "Stasis Shards",
              "classNames": [
                "stasis"
              ]
            },
            {
              "text": " = 5 seconds."
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Tangles",
              "classNames": [
                "strand"
              ]
            },
            {
              "text": " = 12 seconds"
            }
          ]
        },
        {
          "linesContent": [
            {
              "text": "Can spawn 2 Pickups simultaneously if the 12th kill would also trigger a different Pickup spawner."
            }
          ]
        },
        {
          "classNames": [
            "spacer"
          ]
        },
        {
          "linesContent": [
            {
              "text": "Kills during Synergy's cooldown do not contribute to the activation."
            }
          ]
        }
      ]
    }
  },
